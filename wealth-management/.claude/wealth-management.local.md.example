# Active clients (for session reminders)
active_clients:
  - name: "Smith Family"
    type: "Pre-retirement planning"
    stage: "Accumulation — TTR review"
    next_milestone: "Annual review"
    date: "2026-03-15"
    accounts: "Super (accum), Personal, Family Trust"
  - name: "Jones Household"
    type: "Retirement income"
    stage: "Pension phase"
    next_milestone: "Centrelink review after asset sale"
