    accounts: "Super (pension), Personal, Joint"

# Default assumptions
default_assumptions:
  inflation_rate: "2.5%"
  super_guarantee_rate: "12%"
  concessional_cap: "$30,000"
  non_concessional_cap: "$120,000"
  transfer_balance_cap: "$1,900,000"
  age_pension_age: 67
  preservation_age: 60
  financial_year: "1 July - 30 June"

# Benchmarks
default_benchmarks:
  australian_equity: "S&P/ASX 200 Total Return"
  international_equity: "MSCI World ex-AU (AUD)"
  fixed_income: "Bloomberg AusBond Composite"
  balanced: "50% ASX 200 TR / 30% MSCI World / 20% AusBond"

# Fee structure
fee_model: "Fixed fee"  # or "Percentage", "Hybrid"
typical_fee_range: "$3,300 - $6,600 p.a."
